# 复制为根目录 .env，填写敏感配置后执行 docker compose up -d --build
# 不要将 .env 提交到版本库。Compose 会覆盖容器内部的数据库、Redis、Sandbox 地址。

# 对外入口
NGINX_PORT=8088
TZ=Asia/Shanghai

# Postgres
POSTGRES_DB=manus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password

# API 基础配置
ENV=production
LOG_LEVEL=INFO
APP_CONFIG_FILEPATH=config.yaml
SQLALCHEMY_DATABASE_URL=postgresql+asyncpg://postgres:change-this-postgres-password@manus-postgres:5432/manus

# Redis
REDIS_HOST=manus-redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 腾讯云 COS
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_SCHEME=https
COS_BUCKET=
COS_DOMAIN=

# Sandbox
SANDBOX_ADDRESS=manus-sandbox
SANDBOX_IMAGE=manus-sandbox:latest
SANDBOX_NAME_PREFIX=mooc-manus-sandbox
SANDBOX_TTL_MINUTES=60
SANDBOX_NETWORK=manus-network
SANDBOX_CHROME_ARGS=
SANDBOX_HTTPS_PROXY=
SANDBOX_HTTP_PROXY=
SANDBOX_NO_PROXY=

# LLM/MCP 配置写入 api/config.yaml，或按项目配置方式提供。
